# Copy this to .env and fill in real values on the VPS — never commit .env to Git

# Docker image to run (built separately, e.g. via `docker build -t <IMAGE> .`)
IMAGE=clinic_frontend:latest

# Deployment environment — leave UNSET/empty for production (container name stays clinic_frontend — unchanged).
# Set to "staging" in the staging deployment's .env so the container becomes clinic_frontend_staging
# and doesn't collide with the production container on the same host.
# ENV_NAME=staging

# Host port nginx is published on — default 8081 for production, use 8091 for staging
FRONTEND_PORT=8081
